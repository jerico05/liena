{
  "name": "liena",
  "version": "1.0.0",
  "description": "Mise en relation entre prestataires et clients",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "main": "dist/server.js",
  "workspaces": [
    "apps/admin"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "admin:dev": "npm run dev --workspace @liena/admin",
    "admin:build": "npm run build --workspace @liena/admin",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "npm run db:validate && npm run test:unit",
    "test:unit": "node --import tsx --import ./tests/backend-test-env.mjs --test tests/backend.unit.test.ts tests/admin-auth.unit.test.ts",
    "test:db": "node scripts/test-database.mjs"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "find-my-way": "^9.7.0",
    "mysql2": "^3.23.1",
    "valibot": "^1.4.2"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "^2.0.3",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.3",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "resend": "^6.35.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "7.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
