{
  "name": "liena",
  "version": "1.0.0",
  "description": "Mise en relation entre prestataires et clients — monorepo fullstack",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace @liena/api",
    "dev:admin": "npm run dev --workspace @liena/admin",
    "admin:dev": "npm run dev:admin",
    "admin:build": "npm run build:admin",
    "build": "npm run build --workspace @liena/api && npm run build --workspace @liena/admin",
    "build:api": "npm run build --workspace @liena/api",
    "build:admin": "npm run build --workspace @liena/admin",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "npm run db:validate && npm run test:unit --workspace @liena/api",
    "test:unit": "npm run test:unit --workspace @liena/api",
    "test:db": "node scripts/test-database.mjs"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "find-my-way": "^9.7.0",
    "mysql2": "^3.23.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@prisma/client": "7.9.0",
    "prisma": "7.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
