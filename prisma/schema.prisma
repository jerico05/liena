generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProviderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED

  @@map("provider_status")
}

enum ModerationDecisionType {
  APPROVE
  REJECT
  SUSPEND
  REACTIVATE

  @@map("moderation_decision_type")
}

enum ServiceRequestStatus {
  SENT
  ACCEPTED
  DECLINED
  COMPLETED

  @@map("service_request_status")
}

model Category {
  id           Int      @id @default(autoincrement())
  label        String
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfiles ProviderProfile[]

  @@unique([label])
  @@index([isActive, displayOrder])
  @@map("categories")
}

model ProviderProfile {
  id              Int           @id @default(autoincrement())
  yeriaSub        String        @unique @map("yeria_sub")
  displayName     String        @map("display_name")
  categoryId      Int           @map("category_id")
  services        String        @db.Text
  zone            String
  description     String        @db.Text
  indicativePrice Decimal?      @map("indicative_price") @db.Decimal(12, 2)
  contact         String
  mediaRefs       Json?         @map("media_refs")
  status          ProviderStatus @default(DRAFT)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvedAt      DateTime?     @map("approved_at") @db.Timestamptz(3)

  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  moderationDecisions ModerationDecision[]
  serviceRequests    ServiceRequest[]

  @@index([status, isActive, categoryId, zone])
  @@index([categoryId, createdAt])
  @@map("provider_profiles")
}

model ModerationDecision {
  id                Int                   @id @default(autoincrement())
  providerProfileId Int                   @map("provider_profile_id")
  adminUsername     String                @map("admin_username")
  adminYeriaSub     String?               @map("admin_yeria_sub")
  decision          ModerationDecisionType
  reason            String?               @db.Text
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  @@index([providerProfileId, createdAt])
  @@index([adminUsername, createdAt])
  @@map("moderation_decisions")
}

model ServiceRequest {
  id                Int                 @id @default(autoincrement())
  clientYeriaSub    String              @map("client_yeria_sub")
  providerProfileId Int                 @map("provider_profile_id")
  description       String              @db.Text
  zone              String?
  status            ServiceRequestStatus @default(SENT)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  events          RequestEvent[]

  @@index([clientYeriaSub, createdAt])
  @@index([providerProfileId, status, createdAt])
  @@map("service_requests")
}

model RequestEvent {
  id               Int                 @id @default(autoincrement())
  serviceRequestId Int                 @map("service_request_id")
  actorYeriaSub    String              @map("actor_yeria_sub")
  oldStatus        ServiceRequestStatus? @map("old_status")
  newStatus        ServiceRequestStatus  @map("new_status")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  note             String?             @db.Text

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId, createdAt])
  @@index([actorYeriaSub, createdAt])
  @@map("request_events")
}
