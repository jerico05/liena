generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum ProviderStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED

  @@map("provider_status")
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED

  @@map("service_status")
}

enum PricingType {
  FIXED
  HOURLY
  DAILY
  QUOTE

  @@map("pricing_type")
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DISPUTED

  @@map("booking_status")
}

enum NotificationType {
  BOOKING
  MESSAGE
  REVIEW
  SYSTEM
  REMINDER

  @@map("notification_type")
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED

  @@map("report_status")
}

enum ReportTargetType {
  USER
  SERVICE
  REVIEW
  MESSAGE

  @@map("report_target_type")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM

  @@map("message_type")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED

  @@map("review_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  email           String     @unique
  phone           String?    @unique
  passwordHash    String     @map("password_hash")
  avatarUrl       String?    @map("avatar_url")
  roles           UserRole[] @default([CLIENT])
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfile         ProviderProfile?
  addresses               Address[]
  clientBookings          Booking[]                 @relation("BookingClient")
  conversationMemberships ConversationParticipant[]
  conversations           Conversation[]            @relation("ConversationClient")
  sentMessages            Message[]                 @relation("MessageSender")
  authoredReviews         Review[]                  @relation("ReviewAuthor")
  notifications           Notification[]
  favorites               Favorite[]
  filedReports            Report[]                  @relation("ReportReporter")
  reportsAboutUser        Report[]                  @relation("ReportTargetUser")
  moderatedReports        Report[]                  @relation("ReportModerator")
  bookingStatusChanges    BookingStatusHistory[]    @relation("BookingStatusActor")
  auditLogs               AuditLog[]
  adminSessions           AdminSession[]
  adminInvitationsSent    AdminInvitation[]         @relation("AdminInvitationSender")
  passwordResetTokens     AdminPasswordReset[]

  @@index([status, createdAt])
  @@index([lastName, firstName])
  @@map("users")
}

model ProviderProfile {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @unique @map("user_id") @db.Uuid
  businessName      String         @map("business_name")
  slug              String         @unique
  description       String?        @db.Text
  status            ProviderStatus @default(PENDING)
  verificationNotes String?        @map("verification_notes") @db.Text
  verifiedAt        DateTime?      @map("verified_at") @db.Timestamptz(3)
  countryCode       String         @default("TG") @map("country_code") @db.Char(2)
  city              String
  neighborhood      String?
  timeZone          String         @default("Africa/Lome") @map("time_zone")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  services               Service[]
  availabilitySlots      AvailabilitySlot[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]
  conversations          Conversation[]
  reviews                Review[]
  favorites              Favorite[]

  @@index([status, countryCode, city, neighborhood])
  @@map("provider_profiles")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String?
  recipient    String?
  phone        String?
  countryCode  String   @default("TG") @map("country_code") @db.Char(2)
  city         String
  neighborhood String?
  street       String?
  details      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId, isDefault])
  @@index([countryCode, city, neighborhood])
  @@map("addresses")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String   @unique
  description String?  @db.Text
  iconUrl     String?  @map("icon_url")
  isActive    Boolean  @default(true) @map("is_active")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  services Service[]

  @@index([parentId, isActive, position])
  @@map("categories")
}

model Service {
  id                String        @id @default(uuid()) @db.Uuid
  providerProfileId String        @map("provider_profile_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  title             String
  slug              String
  description       String        @db.Text
  pricingType       PricingType   @map("pricing_type")
  price             Decimal?      @db.Decimal(12, 2)
  currency          String        @default("XOF") @db.Char(3)
  durationMinutes   Int?          @map("duration_minutes")
  status            ServiceStatus @default(DRAFT)
  isRemote          Boolean       @default(false) @map("is_remote")
  countryCode       String?       @map("country_code") @db.Char(2)
  city              String?
  neighborhood      String?
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ServiceImage[]
  bookings        Booking[]
  favorites       Favorite[]
  reports         Report[]        @relation("ReportTargetService")

  @@unique([providerProfileId, slug])
  @@unique([id, providerProfileId])
  @@index([categoryId, status, createdAt])
  @@index([providerProfileId, status])
  @@index([countryCode, city, neighborhood, status])
  @@index([status, createdAt])
  @@map("services")
}

model ServiceImage {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_images")
}

model AvailabilitySlot {
  id                String   @id @default(uuid()) @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  dayOfWeek         Int      @map("day_of_week")
  startsAt          DateTime @map("starts_at") @db.Time(0)
  endsAt            DateTime @map("ends_at") @db.Time(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, dayOfWeek])
  @@map("availability_slots")
}

model AvailabilityException {
  id                String   @id @default(uuid()) @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  startsAt          DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime @map("ends_at") @db.Timestamptz(3)
  reason            String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, startsAt, endsAt])
  @@map("availability_exceptions")
}

model Booking {
  id                          String        @id @default(uuid()) @db.Uuid
  reference                   String        @unique
  clientId                    String        @map("client_id") @db.Uuid
  providerProfileId           String        @map("provider_profile_id") @db.Uuid
  serviceId                   String        @map("service_id") @db.Uuid
  addressId                   String?       @map("address_id") @db.Uuid
  status                      BookingStatus @default(PENDING)
  description                 String?       @db.Text
  requestedStartsAt           DateTime      @map("requested_starts_at") @db.Timestamptz(3)
  startsAt                    DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt                      DateTime?     @map("ends_at") @db.Timestamptz(3)
  startedAt                   DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt                 DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt                 DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason          String?       @map("cancellation_reason") @db.Text
  agreedPrice                 Decimal?      @map("agreed_price") @db.Decimal(12, 2)
  currency                    String        @default("XOF") @db.Char(3)
  pricingTypeSnapshot         PricingType   @map("pricing_type_snapshot")
  listedPriceSnapshot         Decimal?      @map("listed_price_snapshot") @db.Decimal(12, 2)
  serviceCurrencySnapshot     String        @map("service_currency_snapshot") @db.Char(3)
  durationMinutesSnapshot     Int?          @map("duration_minutes_snapshot")
  serviceTitleSnapshot        String        @map("service_title_snapshot")
  serviceDescriptionSnapshot  String        @map("service_description_snapshot") @db.Text
  providerNameSnapshot        String        @map("provider_name_snapshot")
  categoryNameSnapshot        String        @map("category_name_snapshot")
  addressCountrySnapshot      String?       @map("address_country_snapshot") @db.Char(2)
  addressRecipientSnapshot    String?       @map("address_recipient_snapshot")
  addressPhoneSnapshot        String?       @map("address_phone_snapshot")
  addressCitySnapshot         String?       @map("address_city_snapshot")
  addressNeighborhoodSnapshot String?       @map("address_neighborhood_snapshot")
  addressStreetSnapshot       String?       @map("address_street_snapshot")
  addressDetailsSnapshot      String?       @map("address_details_snapshot") @db.Text
  addressLatitudeSnapshot     Decimal?      @map("address_latitude_snapshot") @db.Decimal(9, 6)
  addressLongitudeSnapshot    Decimal?      @map("address_longitude_snapshot") @db.Decimal(9, 6)
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  client          User                   @relation("BookingClient", fields: [clientId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile        @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  service         Service                @relation(fields: [serviceId, providerProfileId], references: [id, providerProfileId], onDelete: Restrict)
  address         Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  statusHistory   BookingStatusHistory[]
  review          Review?
  conversation    Conversation?

  @@unique([id, clientId, providerProfileId])
  @@index([clientId, status, createdAt])
  @@index([providerProfileId, status, createdAt])
  @@index([serviceId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  oldStatus   BookingStatus? @map("old_status")
  newStatus   BookingStatus  @map("new_status")
  changedById String?        @map("changed_by_id") @db.Uuid
  note        String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  changedBy User?   @relation("BookingStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Conversation {
  id                String   @id @default(uuid()) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  providerProfileId String   @map("provider_profile_id") @db.Uuid
  bookingId         String?  @map("booking_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client          User                      @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile           @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  booking         Booking?                  @relation(fields: [bookingId, clientId, providerProfileId], references: [id, clientId, providerProfileId], onDelete: Restrict)
  participants    ConversationParticipant[]
  messages        Message[]

  @@unique([clientId, providerProfileId])
  @@unique([bookingId, clientId, providerProfileId])
  @@index([clientId, updatedAt])
  @@index([providerProfileId, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]    @relation("MessageParticipant")

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType @default(TEXT)
  content        String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  participant  ConversationParticipant @relation("MessageParticipant", fields: [conversationId, senderId], references: [conversationId, userId], onDelete: Restrict)
  attachments  MessageAttachment[]
  reports      Report[]                @relation("ReportTargetMessage")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  fileUrl   String   @map("file_url")
  mimeType  String   @map("mime_type")
  byteSize  BigInt   @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model Review {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @map("booking_id") @db.Uuid
  authorId          String       @map("author_id") @db.Uuid
  providerProfileId String       @map("provider_profile_id") @db.Uuid
  rating            Int
  comment           String?      @db.Text
  response          String?      @db.Text
  respondedAt       DateTime?    @map("responded_at") @db.Timestamptz(3)
  status            ReviewStatus @default(PUBLISHED)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking         Booking         @relation(fields: [bookingId, authorId, providerProfileId], references: [id, clientId, providerProfileId], onDelete: Restrict)
  author          User            @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  reports         Report[]        @relation("ReportTargetReview")

  @@unique([bookingId, authorId, providerProfileId])
  @@index([providerProfileId, status, createdAt])
  @@index([authorId, createdAt])
  @@map("reviews")
}

model Favorite {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  providerProfileId String?  @map("provider_profile_id") @db.Uuid
  serviceId         String?  @map("service_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile? @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, providerProfileId])
  @@unique([userId, serviceId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Report {
  id              String           @id @default(uuid()) @db.Uuid
  reporterId      String           @map("reporter_id") @db.Uuid
  targetType      ReportTargetType @map("target_type")
  targetUserId    String?          @map("target_user_id") @db.Uuid
  targetServiceId String?          @map("target_service_id") @db.Uuid
  targetReviewId  String?          @map("target_review_id") @db.Uuid
  targetMessageId String?          @map("target_message_id") @db.Uuid
  reason          String
  description     String?          @db.Text
  status          ReportStatus     @default(PENDING)
  moderatorId     String?          @map("moderator_id") @db.Uuid
  moderatorNotes  String?          @map("moderator_notes") @db.Text
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter      User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  targetUser    User?    @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetService Service? @relation("ReportTargetService", fields: [targetServiceId], references: [id], onDelete: Restrict)
  targetReview  Review?  @relation("ReportTargetReview", fields: [targetReviewId], references: [id], onDelete: Restrict)
  targetMessage Message? @relation("ReportTargetMessage", fields: [targetMessageId], references: [id], onDelete: Restrict)
  moderator     User?    @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AdminSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  tokenHash     String   @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String   @map("csrf_token_hash") @db.Char(64)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  role        UserRole
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy User? @relation("AdminInvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, acceptedAt, revokedAt, expiresAt])
  @@index([invitedById, createdAt])
  @@map("admin_invitations")
}

model AdminPasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("admin_password_resets")
}
