# Copier vers apps/api/.env ou garder un .env à la racine du dépôt (les deux sont lus).
# Admin (autre site) : apps/admin/.env.local — seulement VITE_API_URL.

NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liena_dev?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/liena_dev?schema=public"
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:3000
PUBLIC_API_URL=
TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=lax
ADMIN_USERNAME=admin
ADMIN_PASSWORD=liena-admin-dev

# Plateforme Yeria (PAS l’URL de ton API)
YERIA_BASE_URL=https://yeria.app
YERIA_APP_ID=
YERIA_SERVICE_ID=
YERIA_DEV_KEY_ID=

# Local : PEM à la racine du dépôt
YERIA_SERVICE_PRIVATE_KEY_PATH=service_private.pem
YERIA_SERVICE_PUBLIC_KEY_PATH=service_public.pem

# Netlify (pas de fichier PEM déployé) : une seule variable, PEM complet ou \n
# SERVICE_ED25519_PRIVATE_KEY=
# SERVICE_ED25519_PUBLIC_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=