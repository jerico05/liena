        { "name": "Détail réservation", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}" } },
        { "name": "Accepter réservation (prestataire)", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"startsAt\": \"2030-04-15T10:00:00.000Z\",\n  \"endsAt\": \"2030-04-15T11:00:00.000Z\",\n  \"agreedPrice\": 15000\n}" }, "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/status" } },
        { "name": "Consulter mes disponibilités", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/availability" } },
        { "name": "Ajouter créneau hebdomadaire", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"dayOfWeek\": 1,\n  \"startsAt\": \"08:00\",\n  \"endsAt\": \"17:00\"\n}" }, "url": "{{baseUrl}}/api/v1/availability/slots" } },
        { "name": "Supprimer créneau", "request": { "method": "DELETE", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/availability/slots/{{availabilitySlotId}}" } },
        { "name": "Ajouter indisponibilité", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"startsAt\": \"2030-04-15T10:00:00.000Z\",\n  \"endsAt\": \"2030-04-15T12:00:00.000Z\",\n  \"reason\": \"Indisponible\"\n}" }, "url": "{{baseUrl}}/api/v1/availability/exceptions" } },
        { "name": "Supprimer indisponibilité", "request": { "method": "DELETE", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/availability/exceptions/{{availabilityExceptionId}}" } }
      ]
    },
    {
      "name": "Conversations, favoris, avis, notifications et signalements",
      "item": [
        { "name": "Lister conversations", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/conversations" } },
        { "name": "Lire messages", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages" } },
        { "name": "Envoyer message texte", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"content\":\"Bonjour, pouvons-nous convenir d'un horaire ?\"}" }, "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/messages" } },
        { "name": "Marquer conversation lue", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/conversations/{{conversationId}}/read" } },
        { "name": "Mes favoris", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/favorites" } },
        { "name": "Ajouter favori prestataire", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/favorites/providers/{{providerProfileId}}" } },
        { "name": "Retirer favori prestataire", "request": { "method": "DELETE", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/favorites/providers/{{providerProfileId}}" } },
        { "name": "Ajouter favori service", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/favorites/services/{{serviceId}}" } },
        { "name": "Retirer favori service", "request": { "method": "DELETE", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/favorites/services/{{serviceId}}" } },
        { "name": "Avis publics prestataire", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/reviews/providers/{{providerProfileId}}" } },
        { "name": "Avis après réservation", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"rating\":5,\"comment\":\"Très bonne prestation.\"}" }, "url": "{{baseUrl}}/api/v1/reviews/bookings/{{bookingId}}" } },
        { "name": "Avis après mission", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"rating\":5,\"comment\":\"Très bonne prestation.\"}" }, "url": "{{baseUrl}}/api/v1/reviews/missions/{{missionId}}" } },
        { "name": "Répondre à un avis", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"response\":\"Merci pour votre retour.\"}" }, "url": "{{baseUrl}}/api/v1/reviews/providers/{{providerProfileId}}/reviews/{{reviewId}}/response" } },
        { "name": "Mes notifications", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/notifications" } },
        { "name": "Marquer notification lue", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read" } },
        { "name": "Marquer toutes lues", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/notifications/read-all" } },
        { "name": "Créer signalement", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"targetType\": \"SERVICE\",\n  \"targetId\": \"{{serviceId}}\",\n  \"reason\": \"Contenu inexact\",\n  \"description\": \"Informations à vérifier.\"\n}" }, "url": "{{baseUrl}}/api/v1/reports" } }
      ]
    },
    {
      "name": "Cas négatifs",
      "description": "Ces exemples vérifient les contrats d'erreur. L'authentification x-user-id est une identité de test uniquement et reste désactivée par défaut.",
      "item": [
        { "name": "Refuser pagination service invalide (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"pageSize\":500}" }, "url": "{{baseUrl}}/api/v1/services/search" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Retourne 400', function () { pm.response.to.have.status(400); });", "const body = pm.response.json();", "pm.test('Erreur de validation structurée', function () { pm.expect(body.error.code).to.eql('VALIDATION_ERROR'); pm.expect(body.requestId).to.be.a('string'); });"] } }] },
        { "name": "Refuser route privée sans identité (401)", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/users/me" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Retourne 401 sans identité', function () { pm.response.to.have.status(401); });", "const body = pm.response.json();", "pm.test('Erreur authentification structurée', function () { pm.expect(body.error.code).to.eql('AUTHENTICATION_REQUIRED'); pm.expect(body.requestId).to.be.a('string'); });"] } }] }
      ]
    },
    {
      "name": "Administration",
      "item": [
        { "name": "Obtenir CSRF admin", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/csrf" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.environment.set('csrfToken', body.csrfToken);", "const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);", "const csrf = cookies.map(c => c.split(';')[0]).find(c => /^(?:__Host-)?liena_admin_csrf=/.test(c));", "if (csrf) { pm.environment.set('adminCsrfCookie', csrf); pm.environment.set('adminSessionCookie', csrf); }", "pm.test('Jeton CSRF reçu', function () { pm.expect(body.csrfToken).to.be.a('string'); });"] } }] },
        { "name": "Connexion admin", "request": { "method": "POST", "header": [{ "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}" }, "url": "{{baseUrl}}/api/v1/admin/login" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).map(c => c.split(';')[0]);", "const session = cookies.find(c => /^(?:__Host-)?liena_admin_session=/.test(c));", "const csrf = cookies.find(c => /^(?:__Host-)?liena_admin_csrf=/.test(c)) || pm.environment.get('adminCsrfCookie');", "if (session) pm.environment.set('adminSessionCookie', [session, csrf].filter(Boolean).join('; '));", "if (csrf) pm.environment.set('adminCsrfCookie', csrf);", "pm.test('Connexion admin réussie', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.id).to.be.a('string'); });"] } }] },
        { "name": "Admin courant", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/me" } },
        { "name": "Lister demandes prestataires", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/provider-registrations" } },
        { "name": "Approuver prestataire", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/provider-registrations/{{providerProfileId}}/approve" } },
        { "name": "Refuser prestataire", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"note\":\"Dossier incomplet\"}" }, "url": "{{baseUrl}}/api/v1/admin/provider-registrations/{{providerProfileId}}/reject" } },
        { "name": "Suspendre prestataire", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/provider-registrations/{{providerProfileId}}/suspend" } },
        { "name": "Réactiver prestataire", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/provider-registrations/{{providerProfileId}}/reactivate" } },
        { "name": "Lister utilisateurs", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/users?page=1&pageSize=25" } },
        { "name": "Suspendre/réactiver utilisateur ordinaire (super-admin)", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"SUSPENDED\"}" }, "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}/status" } },
        { "name": "Lister catégories admin", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/categories" } },
        { "name": "Créer catégorie/métier", "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"parentId\": \"{{rootCategoryId}}\",\n  \"name\": \"Plomberie\",\n  \"slug\": \"plomberie\",\n  \"position\": 0\n}" }, "url": "{{baseUrl}}/api/v1/admin/categories" } },
        { "name": "Désactiver catégorie", "request": { "method": "DELETE", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}" } },
        { "name": "Modifier catégorie", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"position\":1,\"isActive\":true}" }, "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}" } },
        { "name": "Lister signalements", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/reports?status=PENDING" } },
        { "name": "Traiter signalement", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"RESOLVED\",\"moderatorNotes\":\"Examen effectué.\"}" }, "url": "{{baseUrl}}/api/v1/admin/reports/{{reportId}}" } },
        { "name": "Lister invitations admin", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/invitations" } },
        { "name": "Inviter un administrateur (super-admin)", "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"new-admin@example.test\",\"role\":\"ADMIN\"}" }, "url": "{{baseUrl}}/api/v1/admin/invitations" } },
        { "name": "Révoquer invitation admin (super-admin)", "request": { "method": "DELETE", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/invitations/{{invitationId}}" } },
        { "name": "Accepter invitation admin", "request": { "method": "POST", "header": [{ "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"token\":\"{{invitationToken}}\",\"firstName\":\"New\",\"lastName\":\"Admin\",\"password\":\"{{temporaryPassword}}\"}" }, "url": "{{baseUrl}}/api/v1/admin/invitations/accept" } },
        { "name": "Demander récupération admin", "request": { "method": "POST", "header": [{ "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\"}" }, "url": "{{baseUrl}}/api/v1/admin/password/forgot" } },
        { "name": "Réinitialiser mot de passe admin", "request": { "method": "POST", "header": [{ "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"token\":\"{{resetToken}}\",\"password\":\"{{temporaryPassword}}\"}" }, "url": "{{baseUrl}}/api/v1/admin/password/reset" } },
        { "name": "Lister administrateurs", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/admins" } },
        { "name": "Modifier rôle administrateur (super-admin)", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"role\":\"ADMIN\"}" }, "url": "{{baseUrl}}/api/v1/admin/admins/{{userId}}/role" } },
        { "name": "Retirer accès administrateur (super-admin)", "request": { "method": "DELETE", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/admins/{{userId}}" } },
        { "name": "Déconnexion admin", "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/logout" } }
      ]
    }
