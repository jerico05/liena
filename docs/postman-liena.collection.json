{
  "info": {
    "name": "Liena API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection de routes réellement montées par Liena. Pour les routes utilisateur, x-user-id est une identité de test uniquement : le serveur doit être hors production avec DEV_AUTH_ENABLED=true et l'UUID doit désigner un compte actif réel. Aucun jeton Yeria n'est encore intégré."
  },
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const status = pm.response.code;",
          "const documentedStatuses = [200, 201, 202, 204, 400, 401, 403, 404, 409, 429, 503];",
          "pm.test('HTTP status is documented and not a server error', function () { pm.expect(documentedStatuses).to.include(status); });",
          "pm.test('Response envelope matches the API contract', function () {",
          "  if (status === 204) { pm.expect(pm.response.text()).to.eql(''); return; }",
          "  const body = pm.response.json();",
          "  pm.expect(body).to.be.an('object');",
          "  if (status >= 400) {",
          "    pm.expect(body.error).to.be.an('object');",
          "    pm.expect(body.error.code).to.be.a('string');",
          "    pm.expect(body.error.message).to.be.a('string');",
          "    pm.expect(body.requestId).to.be.a('string');",
          "  } else if (pm.info.requestName === 'Health') { pm.expect(body.status).to.eql('ok');",
          "  } else if (pm.info.requestName === 'Récupérer OpenAPI') { pm.expect(body.openapi).to.eql('3.0.3'); pm.expect(body.paths).to.be.an('object');",
          "  } else if (pm.info.requestName === 'Obtenir CSRF admin') { pm.expect(body.csrfToken).to.be.a('string');",
          "  } else { pm.expect(body).to.have.any.keys('data', 'status', 'csrfToken', 'openapi'); }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Santé et catalogue",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
        { "name": "Récupérer OpenAPI", "request": { "method": "GET", "url": "{{baseUrl}}/api-docs" } },
        { "name": "Catégories", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" } },
        { "name": "Détail catégorie/métier", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/{{categorySlug}}" } },
        { "name": "Prestations catégorie/métier", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/{{categorySlug}}/services" } },
        { "name": "Recherche prestation", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"q\": \"réparation plomberie\",\n  \"city\": \"Lomé\",\n  \"page\": 1,\n  \"pageSize\": 20\n}" }, "url": "{{baseUrl}}/api/v1/services/search" } }
      ]
    },
    {
      "name": "Zones géographiques",
      "item": [
        { "name": "Zones actives publiques", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/location-zones?countryCode={{countryCode}}&city={{city}}" } },
        { "name": "Lister zones admin", "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}; {{adminCsrfCookie}}" }], "url": "{{baseUrl}}/api/v1/admin/location-zones?countryCode={{countryCode}}&city={{city}}&active=true" } },
        { "name": "Créer zone admin", "request": { "method": "POST", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}; {{adminCsrfCookie}}" }, { "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"countryCode\": \"TG\",\n  \"city\": \"Lomé\",\n  \"neighborhood\": \"Tokoin\",\n  \"isActive\": true\n}" }, "url": "{{baseUrl}}/api/v1/admin/location-zones" } },
        { "name": "Modifier zone admin", "request": { "method": "PATCH", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}; {{adminCsrfCookie}}" }, { "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"isActive\":true}" }, "url": "{{baseUrl}}/api/v1/admin/location-zones/{{locationZoneId}}" } },
        { "name": "Désactiver zone admin", "request": { "method": "DELETE", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}; {{adminCsrfCookie}}" }, { "key": "Origin", "value": "{{appOrigin}}" }, { "key": "x-csrf-token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/v1/admin/location-zones/{{locationZoneId}}" } }
      ]
    },
    {
      "name": "Prestataires et services",
      "item": [
        { "name": "MVP - lister prestataires approuvés", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/providers?q={{providerQuery}}&city={{city}}&categoryId={{categoryId}}&page=1&pageSize=20" } },
        { "name": "MVP - créer profil avec Yeria", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"businessName\": \"Atelier de démonstration\",\n  \"description\": \"Prestations artisanales sur rendez-vous.\",\n  \"city\": \"Lomé\",\n  \"countryCode\": \"TG\"\n}" }, "url": "{{baseUrl}}/api/v1/providers/profile" } },
        { "name": "MVP - mon profil Yeria", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }], "url": "{{baseUrl}}/api/v1/providers/profile/me" } },
        { "name": "Rechercher prestataires", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/providers/search?q={{providerQuery}}&city={{city}}&categoryId={{categoryId}}&minRating=0&page=1&pageSize=20" } },
        { "name": "Profil prestataire public", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/providers/{{providerSlug}}" } },
        { "name": "Mon profil prestataire", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/providers/me/profile" } },
        { "name": "Modifier mon profil prestataire", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Présentation actualisée de mon activité.\",\n  \"city\": \"Lomé\"\n}" }, "url": "{{baseUrl}}/api/v1/providers/me/profile" } },
        { "name": "Soumettre demande prestataire", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"professionCategoryId\": \"{{categoryId}}\",\n  \"businessName\": \"Atelier de démonstration\",\n  \"description\": \"Prestations artisanales sur rendez-vous.\",\n  \"city\": \"Lomé\",\n  \"countryCode\": \"TG\"\n}" }, "url": "{{baseUrl}}/api/v1/providers/register" } },
        { "name": "Lister prestations publiques", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/providers/{{providerSlug}}/services" } },
        { "name": "Lister mes prestations", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/providers/{{providerSlug}}/services/manage" } },
        { "name": "Créer prestation brouillon", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Réparation test\",\n  \"description\": \"Réparation et entretien avec déplacement dans la zone.\",\n  \"pricingType\": \"QUOTE\"\n}" }, "url": "{{baseUrl}}/api/v1/providers/{{providerSlug}}/services" } },
        { "name": "Modifier/publier prestation", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"PUBLISHED\"\n}" }, "url": "{{baseUrl}}/api/v1/providers/{{providerSlug}}/services/{{serviceId}}" } },
        { "name": "Archiver prestation", "request": { "method": "DELETE", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/providers/{{providerSlug}}/services/{{serviceId}}" } }
      ]
    },
    {
      "name": "Compte utilisateur",
      "item": [
        { "name": "Mon profil", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/users/me" } },
        { "name": "Modifier mon profil", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Client\"\n}" }, "url": "{{baseUrl}}/api/v1/users/me" } },
        { "name": "Lister mes adresses", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/users/me/addresses" } },
        { "name": "Créer une adresse", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"label\": \"Domicile\",\n  \"city\": \"Lomé\",\n  \"neighborhood\": \"Tokoin\",\n  \"isDefault\": true\n}" }, "url": "{{baseUrl}}/api/v1/users/me/addresses" } },
        { "name": "Modifier une adresse", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"neighborhood\": \"Bè\"\n}" }, "url": "{{baseUrl}}/api/v1/users/me/addresses/{{addressId}}" } },
        { "name": "Supprimer une adresse", "request": { "method": "DELETE", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/users/me/addresses/{{addressId}}" } }
      ]
    },
    {
      "name": "Demandes",
      "item": [
        { "name": "MVP - créer une demande Yeria", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"providerProfileId\": \"{{providerProfileId}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Réparer une fuite\",\n  \"description\": \"Fuite sous évier, merci de proposer un devis détaillé.\",\n  \"city\": \"Lomé\"\n}" }, "url": "{{baseUrl}}/api/v1/requests" } },
        { "name": "MVP - mes demandes Yeria", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }], "url": "{{baseUrl}}/api/v1/requests/my-requests" } },
        { "name": "MVP - demandes reçues prestataire", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }], "url": "{{baseUrl}}/api/v1/providers/requests" } },
        { "name": "MVP - accepter demande reçue", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }], "url": "{{baseUrl}}/api/v1/providers/requests/{{requestId}}/accept" } },
        { "name": "MVP - refuser demande reçue", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }], "url": "{{baseUrl}}/api/v1/providers/requests/{{requestId}}/decline" } },
        { "name": "MVP - terminer demande reçue", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{yeriaToken}}" }], "url": "{{baseUrl}}/api/v1/providers/requests/{{requestId}}/complete" } },
        { "name": "Lister mes demandes", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/requests" } },
        { "name": "Demandes accessibles au prestataire", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/requests/available" } },
        { "name": "Créer une demande", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Réparer une fuite\",\n  \"description\": \"Fuite sous évier, merci de proposer un devis détaillé.\",\n  \"city\": \"Lomé\",\n  \"neighborhood\": \"Tokoin\"\n}" }, "url": "{{baseUrl}}/api/v1/requests" } },
        { "name": "Consulter une demande", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/requests/{{requestId}}" } },
        { "name": "Annuler une demande ouverte", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/requests/{{requestId}}/cancel" } }
      ]
    },
    {
      "name": "Devis et missions",
      "item": [
        { "name": "Lister mes devis", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/quotes/mine" } },
        { "name": "Lister les devis d'une demande", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/quotes/requests/{{requestId}}" } },
        { "name": "Proposer un devis", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": 15000,\n  \"currency\": \"XOF\",\n  \"message\": \"Je peux effectuer cette réparation cette semaine.\",\n  \"estimatedDurationDays\": 1\n}" }, "url": "{{baseUrl}}/api/v1/quotes/requests/{{requestId}}" } },
        { "name": "Accepter un devis", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/quotes/{{quoteId}}/accept" } },
        { "name": "Refuser un devis", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/quotes/{{quoteId}}/decline" } },
        { "name": "Retirer mon devis", "request": { "method": "POST", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/quotes/{{quoteId}}/withdraw" } },
        { "name": "Lister mes missions", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/missions" } },
        { "name": "Détail mission", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/missions/{{missionId}}" } },
        { "name": "Planifier une mission", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"SCHEDULED\",\n  \"startsAt\": \"2030-04-15T10:00:00.000Z\",\n  \"endsAt\": \"2030-04-15T11:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/api/v1/missions/{{missionId}}/status" } },
        { "name": "Démarrer une mission", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"IN_PROGRESS\"}" }, "url": "{{baseUrl}}/api/v1/missions/{{missionId}}/status" } },
        { "name": "Terminer une mission", "request": { "method": "PATCH", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"COMPLETED\"}" }, "url": "{{baseUrl}}/api/v1/missions/{{missionId}}/status" } }
      ]
    },
    {
      "name": "Réservations et disponibilités",
      "item": [
        { "name": "Lister mes réservations", "request": { "method": "GET", "header": [{ "key": "x-user-id", "value": "{{devUserId}}" }], "url": "{{baseUrl}}/api/v1/bookings" } },
