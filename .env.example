NODE_ENV=development
PORT=3000
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/liena_dev?schema=public"
# Neon : URL avec hôte « -pooler. » + sslmode=require (voir console Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liena_dev?schema=public"
# Optionnel — connexions max vers le pooler (défaut 5 sur Neon)
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=60000
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liena_test?schema=public"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# URL HTTPS publique (ngrok) enregistrée dans la console Yeria — ex. https://xxxx.ngrok-free.dev
PUBLIC_API_URL=
# Domaine réservé ngrok (compte) pour lancer le tunnel : npm run tunnel:ngrok -- -Force
# Créer un domaine : https://dashboard.ngrok.com/domains
NGROK_TUNNEL_URL=
# Mettre 1 avec ngrok (reverse proxy) pour que Express lise la bonne IP client
TRUST_PROXY_HOPS=0
EMAIL_FROM="onboarding@resend.dev"
RESEND_API_KEY=""
COOKIE_SAME_SITE=lax
ADMIN_USERNAME=admin
ADMIN_PASSWORD=liena-admin-dev
# Plateforme Yeria (ne pas remplacer par l'URL ngrok de ton API)
YERIA_BASE_URL=https://yeria.app
YERIA_APP_ID=
YERIA_SERVICE_ID=
YERIA_DEV_KEY_ID=
# Clés PEM à la racine du dépôt (voir docs/api/yeria-config.md)
YERIA_SERVICE_PRIVATE_KEY_PATH=service_private.pem
YERIA_SERVICE_PUBLIC_KEY_PATH=service_public.pem
# Cloudinary — photos candidatures prestataires (obligatoire en production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
